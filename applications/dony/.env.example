# Local API and development authentication. Do not deploy these example tokens.
PORT=8787
DONY_API_BASE_URL=http://127.0.0.1:8787
DONY_API_DEV_AUTH_TOKEN=dony-solari-local-dev
BETTER_AUTH_SECRET=dony-solari-local-development-secret-change-before-deploying
DONY_D1_URL=http://127.0.0.1:8788
DONY_D1_TOKEN=dony-solari-local-database
DONY_MODEL_GATEWAY=dev
DONY_COMPOSIO_ENABLED=false

# Optional live cloud model (server-side only).
DONY_OPENROUTER_API_KEY=
DONY_CLOUD_MODEL=

# Optional real authentication: remove DONY_API_DEV_AUTH_TOKEN to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DONY_APPLE_APP_BUNDLE_IDENTIFIER=com.dony.solari.mobile

# Optional connectors: also set DONY_COMPOSIO_ENABLED=true.
DONY_COMPOSIO_API_KEY=

# Optional StoreKit/Superwall backend integration.
DONY_APP_STORE_ENVIRONMENT=Sandbox
DONY_APP_STORE_APP_ID=
DONY_APP_STORE_KEY_ID=
DONY_APP_STORE_ISSUER_ID=
DONY_APP_STORE_PRIVATE_KEY=
DONY_SUPERWALL_WEBHOOK_SECRET=

# Optional push notifications.
DONY_APNS_KEY_ID=
DONY_APNS_TEAM_ID=
DONY_APNS_PRIVATE_KEY=
DONY_APNS_TOPIC=com.dony.solari.mobile
